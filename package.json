{
  "name": "dsh-bazaar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "集市：按官方 dsh-plugin topic 浏览并安装 DeepSeek Harness 插件",
  "repository": {
    "type": "git",
    "url": "https://github.com/leolee9086/dsh-bazaar.git"
  },
  "homepage": "https://github.com/leolee9086/dsh-bazaar#readme",
  "bugs": {
    "url": "https://github.com/leolee9086/dsh-bazaar/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "plugin-market"
  ],
  "exports": {
    ".": "./src/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "node --check src/host.js && node --check src/catalog.js && node --check src/discovery.js && node --check src/install.js && node --check src/protocol.js && node --check src/tasks.js && node --check src/client/locales.js",
    "test": "pnpm run build:test && node --test tests/protocol.test.js tests/catalog.test.js tests/tasks.test.js tests/panel.test.js",
    "build:test": "tsdown --config tests/tsdown.config.mjs",
    "test:integration": "pnpm run build:test && node --test tests/installer.test.js",
    "test:visual": "tsdown --config tests/visual.config.mjs && node tests/visual-runner.js"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "playwright": "^1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2"
  }
}
